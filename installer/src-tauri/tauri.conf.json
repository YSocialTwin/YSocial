{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YSocial",
  "version": "4.0.0",
  "identifier": "org.ysocialtwin.ysocial.installer",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "YSocial", "width": 640, "height": 600, "resizable": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "YSocial installer and launcher",
    "resources": ["resources/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
