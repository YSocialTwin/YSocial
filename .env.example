# YSocial environment configuration
# Copy this file to .env before starting YSocial, then fill in the values.
# NEVER commit .env to the repository.

# ------------------------------------------------------------------ #
# Required                                                            #
# ------------------------------------------------------------------ #

# Flask secret key — must be a random string of at least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
YSOCIAL_SECRET_KEY=replace-me-with-a-random-string

# ------------------------------------------------------------------ #
# Optional — Flask environment                                        #
# ------------------------------------------------------------------ #

# Set to "production" to enable strict security checks (requires YSOCIAL_SECRET_KEY).
# Set to "development" (default) for permissive dev mode.
# FLASK_ENV=development

# ------------------------------------------------------------------ #
# Optional — Database                                                 #
# ------------------------------------------------------------------ #

# Database backend: sqlite (default) or postgresql
# YSOCIAL_DB_TYPE=sqlite

# PostgreSQL connection URL (required only when YSOCIAL_DB_TYPE=postgresql)
# YSOCIAL_DATABASE_URL=postgresql://user:password@localhost:5432/ysocial

# ------------------------------------------------------------------ #
# Optional — LLM Backend                                             #
# ------------------------------------------------------------------ #

# LLM backend type: ollama, vllm, or a custom host:port
# LLM_BACKEND=ollama

# Custom LLM URL (leave empty if using the default for LLM_BACKEND)
# LLM_URL=

# ------------------------------------------------------------------ #
# Optional — Distributed Computing (Ray + Redis)                     #
# ------------------------------------------------------------------ #

# Redis connection URL
# REDIS_URL=redis://localhost:6379/0

# Ray cluster address
# RAY_ADDRESS=auto
